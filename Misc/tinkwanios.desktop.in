[Desktop Entry]
Version=1.1
Type=Application
Name=Tinkwanios
Comment=Run HolyC Code on X86/RISCV/AArch64 and beyond
Icon=@CMAKE_INSTALL_PREFIX@/share/icons/tinkwanios.png
Exec=tinkwanios
Actions=NewBootEnv;
Categories=Development;Game;

[Desktop Action NewBootEnv]
Name=New Boot Enviroment
Exec=tinkwanios -n
